{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "pwsh.exe",
      "args": ["-ExecutionPolicy", "Bypass", "-Command"]
    }
  },
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "Write-Host",
      "args": ["-Foreground", "Green", "-Background", "Black", "Build complete!"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "Update Versions",
        "Sanitize FOMOD XML Files",
        "Render Markdown to Nexus BBCode",
        "Render Markdown to Plaintext",
        "Serialize Plugins",
        "Compile Papyrus Scripts",
        "Create Archives"
        // "Clean Up BA2 Archives"
      ]
    },
    {
      "label": "Update Versions",
      "type": "shell",
      "command": "./support/common/scripts/version-updater.ps1",
      "args": ["-SkipBackup", "-PluginFiles", "./data/ShipVendorFramework.esp,./data/ShipVendorFramework.esm"]
    },
    {
      "label": "Sanitize FOMOD XML Files",
      "type": "shell",
      "command": "./support/common/scripts/sanitize-fomod-xml.ps1"
    },
    {
      "label": "Render Markdown to Nexus BBCode",
      "type": "shell",
      "command": "./support/common/scripts/markdown-to-nexusbbcode.ps1",
      "args": ["./support/docs/README.md", "./support/docs/HOWTO.md"]
    },
    {
      "label": "Render Markdown to Plaintext",
      "type": "shell",
      "command": "./support/common/scripts/markdown-to-plaintext.ps1",
      "args": [
        "./support/docs/CHANGELOG.md",
        "./support/docs/HOWTO.md",
        "./support/docs/README.md",
        "./support/docs/README.patches.md"
      ]
    },
    {
      "label": "Populate Known Masters",
      "type": "shell",
      "command": "python3",
      "args": [
        "./support/common/scripts/populate-known-masters.py",
        "--full-masters",
        "DarkStar.esm",
        "FalklandSystems.esm",
        "kinggathcreations_spaceship.esm",
        "L-K_Ships.esm",
        "LowLandingPad.esm",
        "Starvival - Immersive Survival Addon.esm",
        "vcDenAstrodynamics.esm",
        "--medium-masters",
        "DarkStar_Astrodynamics.esm",
        "outpostvendorcustomships.esm",
        "--small-masters",
        "dominion.esm",
        "nighthawk.esm",
        "ShipVendorFramework.esm",
        "SVF-ShatteredSpace-Patch.esm"
      ]
    },
    {
      "label": "Serialize Plugins",
      "type": "shell",
      "command": "./support/common/scripts/serialize-plugins.ps1",
      "args": ["-Starfield", "-YAML"],
      "dependsOn": ["Populate Known Masters"]
    },
    {
      "label": "Compile Papyrus Scripts",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Compile Scripts (DarkStar Astrodynamics Patch)",
        "Compile Scripts (Starvival Patch)",
        "Compile Scripts (Main)"
      ],
    },
    {
      "label": "Compile Scripts (DarkStar Astrodynamics Patch)",
      "type": "shell",
      "command": "./support/papyrus-imports/vanilla/bin/PapyrusCompiler/PapyrusCompiler.exe",
      "args": ["./support/scripts/SVFDarkStarAstrodynamicsPatch.ppj"]
    },
    {
      "label": "Compile Scripts (Starvival Patch)",
      "type": "shell",
      "command": "./support/papyrus-imports/vanilla/bin/PapyrusCompiler/PapyrusCompiler.exe",
      "args": ["./support/scripts/SVFStarvivalPatch.ppj"]
    },
    {
      "label": "Populate Mods and Patches in SVF_Control",
      "type": "shell",
      "command": "python3",
      "args": [
        "./support/scripts/populate-mods-patches.py",
        "--papyrus-file",
        "./data/Scripts/Source/ShipVendorFramework/SVF_Control.psc",
        "--mod-patch-pairs",
        "DarkStar.esm", // "DarkStar" by WykkydGaming
        "NONE",
        "DarkStar_Astrodynamics.esm", //"DarkStar Astrodynamics" by WykkydGaming
        "SVF-DarkStarAstrodynamics-Patch.esm",
        "dominion.esm", // "Dominion" by rhart317
        "SVF-Dominion-Patch.esm",
        "FalklandSystems.esm", // "Falkland Systems Ship Services" by Hjalmere
        "SVF-FalklandSystems-Patch.esm",
        "SVF-HideGameplayOptions-Patch.esm", // hide options patch
        "PATCH",
        "nighthawk.esm", // "Iconic Ships" by ShipTechnician
        "SVF-IconicShips-Patch.esm",
        "L-K_Ships.esm", // "L-K Ships" by Lighthorse and KeithVSmith1977
        "SVF-LKShips-Patch.esm",
        "LowLandingPad.esm", // "Lower Landing Pad" by SenterPat
        "SVF-LowerLandingPad-Patch.esm",
        "outpostvendorcustomships.esm", // "Outpost Vendor New Ships" by nefurun
        "SVF-OutpostVendorNewShips-Patch.esm",
        "ShatteredSpace.esm", // "Shattered Space" DLC
        "SVF-ShatteredSpace-Patch.esm",
        "Starvival - Immersive Survival Addon.esm", //"Starvival" by lKocMoHaBTl
        "SVF-Starvival-Patch.esm",
        "vcDenAstrodynamics.esm", // "The Den Astrodynamics" by VoodooChild
        "SVF-TheDenAstrodynamics-Patch.esm",
        "kinggathcreations_spaceship.esm", // "Watchtower" by kinggath_creations
        "SVF-Watchtower-Patch.esm",
        "SFBGS00D.esm", // "Free Lanes" update
        "SVF-FreeLanes-Patch.esm",
        // various keyword patches
        "SVF-ShipModulesDarkStarAstrodynamics-AllVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesDarkStarAstrodynamics-NonOutpostVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesDarkStarAstrodynamics-OutpostVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesFalklandSystems-AllVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesFalklandSystems-NonOutpostVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesFalklandSystems-OutpostVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesVanilla-AllVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesVanilla-NonOutpostVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesVanilla-OutpostVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesWatchtower-AllVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesWatchtower-NonOutpostVendors-KPatch.esm",
        "PATCH",
        "SVF-ShipModulesWatchtower-OutpostVendors-KPatch.esm",
        "PATCH"
      ]
    },
    {
      "label": "Compile Scripts (Main)",
      "type": "shell",
      "command": "./support/papyrus-imports/vanilla/bin/PapyrusCompiler/PapyrusCompiler.exe",
      "args": ["./support/scripts/ShipVendorFramework.ppj"],
      "dependsOn": ["Populate Mods and Patches in SVF_Control"],
    },
    {
      "label": "Create Archives (DarkStar Astrodynamics Patch BA2)",
      "type": "shell",
      "command": "./support/common/scripts/build-archives.ps1",
      "args": [
        "-DataDir",
        "./data-DarkStarAstrodynamics-patch",
        "-PluginName",
        "SVF-DarkStarAstrodynamics-Patch",
        "-Starfield",
        "-Skip7z",
        "-SkipBA2Cleanup",
        "-BA2AlsoMakeXbox",
        "-BA2AlsoMakePS",
        "-BA2ForceUncompressed",
        "-BA2DisableSharing"
      ],
      "problemMatcher": []
    },
    {
      "label": "Create Archives (Starvival Patch BA2)",
      "type": "shell",
      "command": "./support/common/scripts/build-archives.ps1",
      "args": [
        "-DataDir",
        "./data-starvival-patch",
        "-PluginName",
        "SVF-Starvival-Patch",
        "-Starfield",
        "-Skip7z",
        "-SkipBA2Cleanup",
        "-BA2AlsoMakeXbox",
        "-BA2AlsoMakePS",
        "-BA2ForceUncompressed",
        "-BA2DisableSharing"
      ]
    },
    {
      "label": "Create Archives (Main BA2)",
      "type": "shell",
      "command": "./support/common/scripts/build-archives.ps1",
      "args": [
        "-ModName",
        "Ship Vendor Framework",
        "-Starfield",
        "-Skip7z",
        "-SkipBA2Cleanup",
        "-BA2AlsoMakeXbox",
        "-BA2AlsoMakePS",
        "-BA2ForceUncompressed",
        "-BA2DisableSharing"
      ]
    },
    {
      "label": "Create Archives",
      "type": "shell",
      "command": "./support/common/scripts/build-archives.ps1",
      "args": ["-ModName", "Ship Vendor Framework", "-Starfield", "-SkipBA2", "-SkipBA2Cleanup"],
      "dependsOrder": "sequence",
      "dependsOn": [
        "Create Archives (DarkStar Astrodynamics Patch BA2)",
        "Create Archives (Starvival Patch BA2)",
        "Create Archives (Main BA2)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean Up BA2 Archives",
      "type": "shell",
      "command": "Remove-Item",
      "args": ["-Path", "./data/*.ba2", "-Force"]
    },
    {
      "label": "Remove All Compiled Scripts",
      "type": "shell",
      "command": "Get-ChildItem ./data/Scripts/*.pex -Recurse -File | Remove-Item -Force"
    }
  ]
}
